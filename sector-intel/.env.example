# --- LLM ----------------------------------------------------------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-opus-4-7

# --- Search -------------------------------------------------------
BRAVE_SEARCH_API_KEY=

# --- SEC EDGAR ----------------------------------------------------
# SEC requires a User-Agent identifying the requester. Format:
#   "Your Name your-email@example.com"
# Without this, requests will be rate-limited then blocked.
# --- SEC EDGAR ----------------------------------------------------
SEC_USER_AGENT= 

# --- Database -----------------------------------------------------
# On Render, point this at the persistent disk: sqlite:////var/data/sector_intel.db
DATABASE_URL=sqlite:///./data/sector_intel.db

# --- Storage paths -----------------------------------------------
RAW_DOCS_DIR=./data/raw
PARSED_DOCS_DIR=./data/parsed

# --- Google Gemini ------------------------------------------------
# Get a key at https://aistudio.google.com (Gemini Pro tier)
GOOGLE_API_KEY=